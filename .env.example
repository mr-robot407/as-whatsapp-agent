# ─── DO NOT commit real values — store secrets in AWS Secrets Manager ───────

# ── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
# Secrets Manager path: as-whatsapp-agent/meta
# { "access_token": "...", "app_secret": "...", "verify_token": "...",
#   "waba_id": "...", "phone_number_id": "..." }
META_ACCESS_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME
META_WEBHOOK_VERIFY_TOKEN=REPLACE_ME
META_BUSINESS_MANAGER_ID=1205405625998390
META_WABA_ID=1615402749911697
META_PHONE_NUMBER_ID=REPLACE_ME
META_DISPLAY_NUMBER=+919560206195

# ── TRAI / DLT (India) ──────────────────────────────────────────────────────
# Secrets Manager path: as-whatsapp-agent/dlt
# { "aggregator_api_key": "...", "principal_entity_id": "...", "header_id": "ATSHRN" }
DLT_AGGREGATOR=REPLACE_ME              # e.g. jio | airtel | vi | tata | routemobile | gupshup
DLT_PRINCIPAL_ENTITY_ID=REPLACE_ME
DLT_HEADER_ID=ATSHRN

# ── Razorpay (SHARED with email agent — reuse credentials) ──────────────────
# Secrets Manager path: as-email-agent/razorpay   ← same path, do not duplicate
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Google Calendar (SHARED with email agent — reuse credentials) ───────────
# Secrets Manager path: as-email-agent/google-oauth
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_CALENDAR_ID=ateliershreenu@gmail.com
GOOGLE_BOOKINGS_CALENDAR_NAME=Atelier Shreenu — Bookings

# ── Partner internal notifications (never sent to Client) ───────────────────
# Used only for T-2h partner reminder at S1.16 and internal ops alerts.
PARTNER_WHATSAPP_E164=+919560107193
PARTNER_EMAIL=ranjeet.mukherjee@gmail.com

# ── Analytics ───────────────────────────────────────────────────────────────
GA4_PROPERTY_ID=543504017
GA4_MEASUREMENT_ID=G-GN7NVMP4TN
GTM_CONTAINER_ID=GTM-THQH822B

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# Shared with email agent — same DynamoDB table per §9.3.
# Name is a legacy artefact (the table pre-dates the WhatsApp channel);
# DynamoDB does not support renames, and the schema already matches §9.3
# (PK contact_id, SK sk, GSI-EMAIL on email_normalised, GSI-PHONE on phone_e164).
TABLE_NAME=as-email-contacts
GSI_PHONE=GSI-PHONE
GSI_EMAIL=GSI-EMAIL
AWS_PROFILE=atelier
AWS_ACCOUNT_ID=664106307979

MEDIA_BUCKET=as-whatsapp-media
EVENT_ARCHIVE_BUCKET=as-whatsapp-events
DLQ_URL=REPLACE_ME

# Webhook endpoint (set after first deploy)
WEBHOOK_URL=https://TODO.execute-api.ap-south-1.amazonaws.com/prod/whatsapp
UNSUBSCRIBE_URL=https://TODO.execute-api.ap-south-1.amazonaws.com/prod/unsubscribe

# ── Operating rules ─────────────────────────────────────────────────────────
OPERATING_TZ=Asia/Kolkata
OPERATING_HOURS=09:00-18:00
OPERATING_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
BROADCAST_DAILY_CAP=50
BROADCAST_BATCH_SIZE=10
BROADCAST_BATCH_INTERVAL_MINUTES=90
MARKETING_TEMPLATES_PER_RECIPIENT_PER_YEAR=4
